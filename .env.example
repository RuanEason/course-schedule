DATABASE_URL="mysql://user:password@127.0.0.1:3306/class_schedule"
EDITOR_ENABLED="true"
NEXT_PUBLIC_CONFIG_URL="http://localhost:3000/config.json"

# Multi-class. The bare `/` and `/config.json` entry point serves this class,
# which keeps an already-deployed Electron client working untouched. Leave it as
# `default` unless the unprefixed address should belong to another class.
CLASS_CONFIG_SLUG="default"

# DingTalk internal web application
DINGTALK_CORP_ID=""
DINGTALK_CLIENT_ID=""
DINGTALK_CLIENT_SECRET=""
APP_ORIGIN="http://localhost:3000"

# Local-only mock identity. Keep false or unset in production.
DINGTALK_DEV_AUTH="true"
DINGTALK_DEV_USER_ID="dev-user"
DINGTALK_DEV_UNION_ID="dev-union-user"
DINGTALK_DEV_USER_NAME="本地测试用户"
DINGTALK_DEV_USER_TITLE="班主任"
DINGTALK_DEV_USER_ADMIN="false"
DINGTALK_DEV_USER_BOSS="false"
DINGTALK_DEV_USER_SENIOR="false"
# Classes the mock identity may edit. Real users get memberships from the
# 「班级管理」admin page; the mock user exists only at runtime, so it is granted
# classes here (comma-separated). Development only.
DINGTALK_DEV_USER_CLASSES="default,class2,class3"
